# Canonical site URL for OG images and metadata (must match custom domain)
NEXT_PUBLIC_SITE_URL=https://basemate.app

# Production agent API (required on Railway — same project as xmtp-agent)
AGENT_API_HOST=https://xmtp-agent-production-e08b.up.railway.app

# Optional override for /portfolio proxy. Defaults to AGENT_API_HOST when unset.
# Local dev (basemate-tba on :3000, metrics on :3001):
#   AGENT_API_HOST=http://localhost:3000
#
# UI preview — iterate on /app without agent, DB, or CDP (dev only):
#   APP_UI_PREVIEW=1
#   NEXT_PUBLIC_APP_UI_PREVIEW=1
IMESSAGE_PORTFOLIO_API_HOST=
# Preferred channels API for /pay and the Offramp BFF.
CHANNELS_API_HOST=

# Postgres — used for /pay fund_sessions (and legacy waitlist table if present).
# /pay must use the same DB as basemate-imessage so it can redeem Coinbase payment-link sessions.
# Also powers the /data-room Notion-synced content.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Notion CMS → /data-room (optional; falls back to src/lib/investor.ts)
# 1. Create integration at notion.so/my-integrations
# 2. Share "Startup Data Room" with the integration
# 3. node scripts/wire-notion-data-room.mjs  → writes docs/notion-data-room.ids.env
NOTION_API_KEY=
NOTION_DATA_ROOM_PAGE_ID=
NOTION_CONTENT_DB_ID=
NOTION_PIPELINE_DB_ID=
# Protect POST /api/cron/notion-data-room (Railway cron every 15m)
DATA_ROOM_SYNC_SECRET=

# Coinbase Headless Onramp sandbox:
# Set basemate-imessage CDP_FUND_PAGE_URL=http://localhost:3001/pay
# and CDP_FUND_PAGE_DOMAIN=localhost when testing this app locally.
# On the channels service, allowlist and configure:
# CDP_OFFRAMP_REDIRECT_URL=https://basemate.app/pay/offramp/return
# CDP_PAY_PAGE_ORIGIN=https://basemate.app

# Bankr lifetime volume — metrics app reads Dune GET (no execute, no credits per poll).
# Use the dashboard query: https://dune.com/freeksh00w/basemate
DUNE_API_KEY=
DUNE_BANKR_LIFETIME_QUERY_ID=7729265
